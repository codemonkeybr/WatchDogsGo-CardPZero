PKG_NAME=watchdogsgo-cardputerzero
PKG_VERSION=0.1.1
PKG_REVISION=1
PKG_DESC="WatchDogsGo — WiFi/BLE/LoRa/SDR wardriving RPG, ported to the CardputerZero"
PKG_DEPENDS="python3, python3-serial, python3-pil, python3-cryptography, python3-scapy, python3-bleak, python3-nacl, python3-netifaces, python3-dbus, python3-gi, python3-rpi-lgpio, python3-lgpio, python3-libgpiod, python3-spidev, python3-smbus2, network-manager, iw"
PKG_RECOMMENDS="rtl-sdr, rtl-433, librtlsdr0, libncurses6, libzstd1"
PKG_MAINTAINER="Tesso Codemonkey <codemonkeybr@users.noreply.github.com>"
PKG_HOMEPAGE="https://github.com/LOCOSP/WatchDogsGo"
APP_NAME="WatchDogsGo (beta)"
APP_EXEC=/usr/share/APPLaunch/bin/watchdogsgo-cardputerzero
APP_TERMINAL=false
APP_ICON=share/images/watchdogsgo-cardputerzero.png
